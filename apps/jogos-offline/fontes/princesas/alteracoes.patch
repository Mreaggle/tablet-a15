+* { box-sizing: border-box; }
+html { color: #482543; background: #fdf4fa; }
+body { margin: 0; font: 15px system-ui, sans-serif; }
+button { font: inherit; color: inherit; -webkit-tap-highlight-color: transparent; touch-action: manipulation; cursor: pointer; }
+button img { display: block; user-select: none; }
+[aria-pressed="true"] { border-color: #b53b81 !important; background: #ffe2f2 !important; }
+.topbar { display: flex; align-items: center; padding: 6px 14px; min-height: 54px; background: #fff; border-bottom: 1px solid #efd7e6; }
+.topbar h1 { font-size: 22px; margin: 0 auto 0 0; }
+.topbar button { margin-left: 8px; border: 0; border-radius: 11px; background: #f4e8ff; min-height: 42px; display: flex; align-items: center; padding: 4px 8px; }
+.topbar button img { width: 23px; height: 23px; margin-right: 5px; }
+.game { max-width: 850px; margin: 0 auto; padding: 8px 10px; }
+.dressing-room { height: 47vh; min-height: 230px; max-height: 560px; }
+.stage { position: relative; height: 100%; border-radius: 16px; overflow: hidden; background: #f8e9f3; }
+.stage-bg, .stage-layer, .stage-inner { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
+.stage-bg { object-fit: cover; }
+.stage-layer { object-fit: contain; object-position: center bottom; pointer-events: none; }
+.miniatures, .category-tabs, .item-grid { display: grid; margin-top: 6px; }
+.miniatures { grid-gap: 5px; }
+.miniatures.dolls { grid-template-columns: repeat(4,minmax(0,1fr)); }
+.miniatures.scenes { grid-template-columns: repeat(6,minmax(0,1fr)); }
+.miniatures button, .category-tab, .item-card { background: #fff; border: 2px solid #ead8e7; border-radius: 11px; min-width: 0; padding: 0; }
+.miniatures button { height: 48px; overflow: hidden; }
+.miniatures img { width: 100%; height: 100%; object-fit: contain; }
+.scenes img { object-fit: cover; }
+.category-tabs { grid-template-columns: repeat(5,minmax(0,1fr)); grid-gap: 4px; }
+.category-tab { min-height: 56px; padding: 3px 1px; font-size: 12px; }
+.category-tab img { width: 30px; height: 30px; object-fit: contain; margin: 0 auto; }
+.item-grid { grid-template-columns: repeat(4,minmax(0,1fr)); grid-gap: 5px; }
+.item-card { height: 70px; padding: 4px; }
+.item-card img { width: 100%; height: 100%; object-fit: contain; }
+@media (orientation: landscape) and (min-width: 600px) {
+  .game { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); grid-gap: 12px; max-width: 1100px; }
+  .dressing-room { height: calc(100vh - 72px); max-height: none; }
+  .choices { overflow-y: auto; max-height: calc(100vh - 72px); }
+}
+@media (max-width: 360px) {
+  .topbar h1 { font-size: 18px; }
+  .topbar button { font-size: 12px; }
+  .category-tab { font-size: 10px; }
 }
